		local function resolveFamily(family, name)
			local familyData = FAMILIES[string.lower(family or "")]
			if not familyData then
				return nil
			end
			local target = familyData[string.lower(name or "")]
			if type(target) == "string" then
				target = DATA[target]
			end
			return target and { Type = "Vector", Name = family .. ":" .. name, L = target.L or {}, C = target.C or {} } or nil
		end
